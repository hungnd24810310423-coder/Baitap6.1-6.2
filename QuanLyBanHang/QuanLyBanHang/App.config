<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <!-- Đổi Data Source nếu cần:  .\SQLEXPRESS   hoặc   (localdb)\MSSQLLocalDB -->
    <add name="BanHangDB"
         connectionString="Data Source=.;Initial Catalog=BanHangDB;Integrated Security=True;TrustServerCertificate=True"
         providerName="Microsoft.Data.SqlClient" />
  </connectionStrings>
</configuration>
